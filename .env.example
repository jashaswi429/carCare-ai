# ---------------------------------------------------------------------------
# AI Predictive Car Care Platform - environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in the values.
#
# NOTE: only variables prefixed with VITE_ are exposed to the browser.
# NEVER put an AI provider key or the Supabase service_role key in this file.
# Those belong in Supabase Edge Function secrets (server-side only).
# ---------------------------------------------------------------------------

# Supabase project URL  (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase anon/public key
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Development only: if the two values above are empty `npm run dev` starts in
# LOCAL DEMO MODE - authentication and data are stored in the browser's
# localStorage so the product can be run and reviewed without a backend.
# All product features stay identical - only the persistence layer changes.
#
# Production builds (`npm run build`) REQUIRE both values. If they are missing
# the app fails closed with a configuration error and never falls back to the
# insecure local demo backend.
# ---------------------------------------------------------------------------
